# Copy to FE/.env.local (not committed). Vite exposes only VITE_* variables to the browser.

# REST API (default: same host, /api/v1 behind nginx or the Vite proxy)
VITE_API_BASE_URL=/api/v1

# Speech services used by the oral exam room.
# Absolute ws:// / http:// URLs for local development; a relative path (e.g. /ws/stt, /tts)
# is resolved against the page host when the services sit behind nginx.
VITE_STT_WS_URL=ws://localhost:8002/ws/transcribe
VITE_TTS_URL=http://localhost:8001
