# ============================================================
# Vieva — Environment Variables Template
# Copy this file to .env (never commit .env to version control)
# ============================================================

# ── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vieva_db
DB_USER=postgres
# REQUIRED: use a strong password in production
DB_PASSWORD=change_me_strong_password

# ── JWT ─────────────────────────────────────────────────────
# REQUIRED: generate with: openssl rand -base64 64
# Must be at least 32 characters; no default — app fails to start without it
JWT_SECRET=
JWT_EXPIRATION_HOURS=1

# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Cloudinary ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
