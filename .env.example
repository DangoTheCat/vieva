# ============================================================
# Vieva — Environment Variables Template
# Copy this file to .env (never commit .env to version control)
# ============================================================

# ── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vieva_db
DB_USER=postgres
# REQUIRED: use a strong password in production
DB_PASSWORD=change_me_strong_password

# ── JWT ─────────────────────────────────────────────────────
# REQUIRED: generate with: openssl rand -base64 64
# Must be at least 32 characters; no default — app fails to start without it
JWT_SECRET=
JWT_EXPIRATION_HOURS=1

# ── AI (OpenAI-compatible) ──────────────────────────────────
# mock = offline (default) | openai/gemini = OpenAI-compatible LLM + embeddings
VIEVA_AI_PROVIDER=mock
OPENAI_API_KEY=sk-...
# OpenAI defaults: base https://api.openai.com/v1.
# Gemini (OpenAI-compatible endpoint):
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_CHAT_MODEL=gemini-3.5-flash-lite
#   OPENAI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# ── Cloudinary ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (account-created notification) ────────────────────
# log = offline (default, nothing sent) | smtp = send via the SMTP server below
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_PASSWORD=<App Password>
VIEVA_MAIL_PROVIDER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@vieva.local
APP_LOGIN_URL=http://localhost:5173/login
